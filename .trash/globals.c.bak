#include "INTERN.h"
#define PERL_IN_GLOBALS_C
#include "perl.h"

/* regcomp.h isn't #included in perl.h */
#include "regcomp.h"

/*
 * Force storage allocation for PERLVAR (no-init) globals from intrpvar.h
 * when MULTIPLICITY is off. perl.h declares them as 'extern' only.
 */
Stack_off_t *PL_markstack_ptr;
Stack_off_t *PL_markstack_max;
Stack_off_t *PL_markstack;
SV **PL_stack_base;
SV **PL_stack_sp;
SV **PL_stack_max;
I32 PL_markstack_idx;
I32 PL_markstack_max_idx;

/* add any other PERLVAR (no-init) vars that linker complains about */

#if defined(USE_ITHREADS) && defined(PERL_THREAD_LOCAL)
PERL_THREAD_LOCAL void *PL_current_context;
#endif

