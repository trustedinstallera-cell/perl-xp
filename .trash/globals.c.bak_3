#include "INTERN.h"
#define PERL_IN_GLOBALS_C
#include "perl.h"

#include "regcomp.h"

/* ========== perlvars.h: G-prefix globals ========== */
#undef PERLVAR
#undef PERLVARI
#undef PERLVARIC

#define PERLVAR(Gprefix, name, type)          type PL_##name;
#define PERLVARI(Gprefix, name, type, init)   type PL_##name;
#define PERLVARIC(Gprefix, name, type, init, cond) type PL_##name;

#include "perlvars.h"

/* ========== intrpvar.h: I-prefix globals ========== */
#undef PERLVAR
#undef PERLVARI
#undef PERLVARIC

#define PERLVAR(name, type)        type PL_##name;
#define PERLVARI(name, type, init) type PL_##name;
#define PERLVARIC(name,type,init,cond) type PL_##name;

#include "intrpvar.h"

#if defined(USE_ITHREADS) && defined(PERL_THREAD_LOCAL)
PERL_THREAD_LOCAL void *PL_current_context;
#endif